# Reference only. Keep real secrets outside Git; simulation makes no provider calls.
PORT=10000
HOST=127.0.0.1
RAVEN_AI_PROVIDER=simulation
RAVEN_OPENAI_MODEL=gpt-5.2
OPENAI_API_KEY=
# Both model providers: positive integers; invalid settings reject startup.
# Timeout includes response body (1–120000 ms); concurrency is per process (1–16).
RAVEN_MODEL_TIMEOUT_MS=30000
RAVEN_MODEL_MAX_CONCURRENT=4
# RAVEN_DIALOGUE_STORAGE_PATH=/absolute/path/to/preview-store.json
# Optional reviewed public site export, served at /raven/ alongside this server:
# RAVEN_SITE_ROOT=/absolute/path/to/public-site
# Private written case; both files stay outside Git and the public site:
# RAVEN_CASE_CONTENT_PATH=/absolute/private/raven-case-content.json
# RAVEN_CASE_STORAGE_PATH=/absolute/private/case-store.json
# Set behind a TLS-terminating proxy:
# RAVEN_COOKIE_SECURE=1
# Existing compatible-provider settings remain supported (optional):
# RAVEN_AI_PROVIDER=compatible
# RAVEN_MODEL_KEY=
# RAVEN_MODEL_BASE=https://api.x.ai/v1
# RAVEN_MODEL_NAME=grok-3
# Disable new external calls without disabling written replies/history:
# RAVEN_MODEL_CALLS_ENABLED=0
# Optional operator JSON file, read before each new generation; errors disable calls:
# RAVEN_RUNTIME_CONTROL_PATH=/absolute/private/runtime-control.json
# File content: {"version":1,"providerCallsEnabled":false}
